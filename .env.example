# Shared by `npm run server` and `npm run agent`. Copy to .env and fill in.
# Generate each value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
ADMIN_TOKEN=

# Agent step
DEMO_REPO=loek-solutionslab/commentbox-demo
COMMENTBOX_API_URL=http://localhost:8787
# Optional: public base URL where you host the saved screenshots (data/shots/<id>.jpg)
SCREENSHOT_PUBLIC_URL_PREFIX=
# Optional: overrides the requested text in the issue
REQUESTED_TEXT=
# Set to 1 to print the issue instead of calling gh
AGENT_DRY_RUN=
